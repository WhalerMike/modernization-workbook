/.quarto/
/_site/
/_docx/
# generated at build time by scripts/generate_sitemap.py
/_sitemap-tree.md

**/*.quarto_ipynb

# Word files are rendered by CI from the Markdown sources; don't commit copies.
# The reference template stays tracked.
*.docx
!/assets/reference-mslearn.docx
# Word lock files
~$*.docx
# reference-mslearn.docx copies the deploy workflow makes under docs/ are covered by *.docx above

# Python and OS cruft
__pycache__/
*.pyc
.DS_Store

# Narrated MP4 exports exceed GitHub limits; attach them to a release instead
presentations/**/*.mp4
