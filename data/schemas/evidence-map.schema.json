{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://whalermike.github.io/modernization-workbook/data/schemas/evidence-map.schema.json",
  "title": "Dependency evidence map",
  "description": "Typed entities joined by typed, directed, sourced and dated relationships, as Book 18 Chapter 02 ('Recording dependencies as an evidence map') describes. Dates are ISO 8601 strings. scripts/check_evidence_maps.py validates a map against this schema and then applies the rules a schema can't express.",
  "type": "object",
  "additionalProperties": false,
  "required": ["map", "entities", "relationships"],
  "properties": {
    "map": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "as_of"],
      "properties": {
        "id": {"type": "string", "pattern": "^FMP-EM-[A-Z0-9-]+$"},
        "title": {"type": "string", "minLength": 1},
        "as_of": {"$ref": "#/$defs/date", "description": "The date the map describes. No evidence or observation may be later."},
        "example": {"type": "boolean", "default": false, "description": "An illustrative map: judged at its own as_of, never at today's date."},
        "stale_after_days": {"type": "integer", "minimum": 1, "default": 365, "description": "A current link not observed for this long is reported as stale."},
        "notes": {"type": "string"}
      }
    },
    "entities": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/entity"}
    },
    "relationships": {
      "type": "array",
      "items": {"$ref": "#/$defs/relationship"}
    },
    "open_questions": {
      "type": "array",
      "items": {"$ref": "#/$defs/question"}
    }
  },
  "$defs": {
    "date": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "id": {"type": "string", "pattern": "^[A-Z][A-Z0-9]*(-[A-Z0-9]+)+$"},
    "entity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "name"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "type": {"enum": ["application", "data_store", "data_element", "data_exchange", "process", "rule", "governance_document", "finding"]},
        "name": {"type": "string", "minLength": 1},
        "description": {"type": "string"},
        "owner": {"type": "string"},
        "master_record": {"type": "boolean", "description": "data_store only: this store is a master record other systems read."},
        "partner": {"type": "string", "description": "data_exchange only: the outside organization, by role, not by name (for example 'a state agency')."},
        "term_ends": {"$ref": "#/$defs/date", "description": "data_exchange or governance_document: when the agreement or notice that authorizes it lapses."}
      },
      "allOf": [
        {"if": {"properties": {"type": {"const": "data_exchange"}}}, "then": {"required": ["partner"]}},
        {"if": {"required": ["master_record"]}, "then": {"properties": {"type": {"const": "data_store"}}}},
        {"if": {"required": ["partner"]}, "then": {"properties": {"type": {"const": "data_exchange"}}}}
      ]
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref", "revised"],
      "properties": {
        "ref": {"type": "string", "minLength": 1, "description": "The document, log extract or code reference."},
        "revised": {"$ref": "#/$defs/date", "description": "The source's own revision date."}
      }
    },
    "relationship": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "from", "to", "kind", "basis", "evidence", "confidence", "status"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "from": {"$ref": "#/$defs/id"},
        "to": {"$ref": "#/$defs/id"},
        "kind": {"enum": ["reads", "writes", "feeds", "calls", "governs", "replaces", "contains"]},
        "basis": {"enum": ["observed", "documented", "planned", "historical"]},
        "evidence": {"type": "array", "items": {"$ref": "#/$defs/evidence"}},
        "observed": {"$ref": "#/$defs/date", "description": "When someone last confirmed the link."},
        "confidence": {"enum": ["measured", "attested", "assumed"]},
        "status": {"enum": ["current", "retired", "planned"]},
        "target_date": {"$ref": "#/$defs/date"},
        "question": {"$ref": "#/$defs/id", "description": "The open question that would settle this link."},
        "notes": {"type": "string"}
      },
      "allOf": [
        {"if": {"properties": {"basis": {"const": "observed"}}}, "then": {"required": ["observed"]}},
        {"if": {"properties": {"status": {"const": "planned"}}}, "then": {"required": ["target_date"]}},
        {"if": {"properties": {"confidence": {"const": "measured"}}}, "then": {"properties": {"basis": {"const": "observed"}}}}
      ]
    },
    "question": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "about", "question", "owner", "asked"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "about": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/id"}},
        "question": {"type": "string", "minLength": 1},
        "owner": {"type": "string", "minLength": 1, "description": "Who can answer it, by role."},
        "asked": {"$ref": "#/$defs/date"},
        "answered": {"$ref": "#/$defs/date"}
      }
    }
  }
}
