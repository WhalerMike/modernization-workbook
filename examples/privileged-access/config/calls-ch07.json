      "id": "ar-definitions-list",
      "api": "graph",
      "method": "GET",
      "version": "v1.0",
      "path": "/identityGovernance/accessReviews/definitions",
      "permissions": ["AccessReview.Read.All"],
      "delegatedRoles": "Security Reader, Identity Governance Administrator, Privileged Role Administrator or Security Administrator (reviews of Microsoft Entra roles)",
      "stage": "v1.0",
      "tasks": ["access-reviews-plan", "access-reviews-apply", "access-reviews-evidence"],
      "learn": "https://learn.microsoft.com/graph/api/accessreviewset-list-definitions?view=graph-rest-1.0",
      "note": "$filter isn't supported on principalResourceMembershipsScope, so the code lists every definition and matches by displayName."
    },
    {
