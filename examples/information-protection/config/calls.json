{
  "_comment": "Every read the baseline export runs, in order. All are read cmdlets; the kit runs no Set-, New-, Remove-, Enable- or Disable- cmdlet. 'shell' is where the cmdlet runs: scc (Security & Compliance PowerShell, Connect-IPPSSession), exo (Exchange Online PowerShell, Connect-ExchangeOnline) or aip (the AIPService module, Connect-AipService). The export connects one shell at a time and disconnects before the next, as Book 20, Chapter 12 does. 'file' is the file it writes in the snapshot folder; the first nine are Chapter 12's baseline names. 'role' is a role that can run the read, from the Learn page in 'doc' or the Book 20 chapter that cites it; least privilege is the agency's to confirm. 'tasks' names the kit's checks that read the file. Read on Microsoft Learn on Nov 11, 2026 (for Book 20) and Nov 24, 2026.",
  "version": 1,
  "calls": [
    { "id": "labels", "shell": "scc", "cmdlet": "Get-Label", "args": { "IncludeDetailedLabelActions": true }, "file": "labels.json", "role": "Compliance Administrator, or Information Protection Admin", "tasks": ["labels", "protection", "drift"], "doc": "https://learn.microsoft.com/powershell/module/exchangepowershell/get-label" },
    { "id": "labelPolicies", "shell": "scc", "cmdlet": "Get-LabelPolicy", "args": {}, "file": "label-policies.json", "role": "Compliance Administrator, or Information Protection Admin", "tasks": ["labels", "drift"], "doc": "https://learn.microsoft.com/powershell/module/exchangepowershell/get-labelpolicy" },
    { "id": "autoLabelPolicies", "shell": "scc", "cmdlet": "Get-AutoSensitivityLabelPolicy", "args": {}, "file": "autolabel-policies.json", "role": "Compliance Administrator", "tasks": ["autolabel", "drift"], "doc": "https://learn.microsoft.com/powershell/module/exchangepowershell/get-autosensitivitylabelpolicy" },
    { "id": "autoLabelRules", "shell": "scc", "cmdlet": "Get-AutoSensitivityLabelRule", "args": {}, "file": "autolabel-rules.json", "role": "Compliance Administrator", "tasks": ["autolabel"], "doc": "https://learn.microsoft.com/powershell/module/exchangepowershell/get-autosensitivitylabelrule" },
    { "id": "dlpPolicies", "shell": "scc", "cmdlet": "Get-DlpCompliancePolicy", "args": {}, "file": "dlp-policies.json", "role": "Compliance Administrator, or the DLP Compliance Management role group", "tasks": ["dlp", "drift"], "doc": "https://learn.microsoft.com/powershell/module/exchangepowershell/get-dlpcompliancepolicy" },
    { "id": "dlpRules", "shell": "scc", "cmdlet": "Get-DlpComplianceRule", "args": {}, "file": "dlp-rules.json", "role": "Compliance Administrator, or the DLP Compliance Management role group", "tasks": ["dlp", "drift"], "doc": "https://learn.microsoft.com/powershell/module/exchangepowershell/get-dlpcompliancerule" },
    { "id": "sitCatalog", "shell": "scc", "cmdlet": "Get-DlpSensitiveInformationType", "args": {}, "file": "sit-catalog.json", "role": "Compliance Administrator, or the DLP Compliance Management role group", "tasks": ["inventory", "autolabel"], "doc": "https://learn.microsoft.com/powershell/module/exchangepowershell/get-dlpsensitiveinformationtype" },
    { "id": "policyConfig", "shell": "scc", "cmdlet": "Get-PolicyConfig", "args": {}, "file": "policy-config.json", "role": "Compliance Administrator", "tasks": ["protection"], "doc": "https://learn.microsoft.com/powershell/module/exchangepowershell/get-policyconfig" },
    { "id": "auditRetention", "shell": "scc", "cmdlet": "Get-UnifiedAuditLogRetentionPolicy", "args": {}, "file": "audit-retention-policies.json", "role": "Compliance Administrator, or Organization Management", "tasks": ["audit", "drift"], "doc": "https://learn.microsoft.com/powershell/module/exchangepowershell/get-unifiedauditlogretentionpolicy" },
    { "id": "roleGroups", "shell": "scc", "cmdlet": "Get-RoleGroupMember", "args": {}, "perRoleGroup": true, "file": "role-groups.json", "role": "Compliance Administrator, or Organization Management", "tasks": ["access"], "doc": "https://learn.microsoft.com/powershell/module/exchangepowershell/get-rolegroupmember" },
    { "id": "contentExplorer", "shell": "scc", "cmdlet": "Export-ContentExplorerData", "args": {}, "perClass": true, "optional": "inventory", "file": "content-explorer.json", "role": "Content Explorer List viewer", "tasks": ["inventory"], "doc": "https://learn.microsoft.com/powershell/module/exchangepowershell/export-contentexplorerdata" },
    { "id": "irmConfiguration", "shell": "exo", "cmdlet": "Get-IRMConfiguration", "args": {}, "file": "irm-configuration.json", "role": "Organization Management, or View-Only Configuration", "tasks": ["protection", "drift"], "doc": "https://learn.microsoft.com/powershell/module/exchangepowershell/get-irmconfiguration" },
    { "id": "auditStatus", "shell": "exo", "cmdlet": "Get-AdminAuditLogConfig", "args": {}, "select": ["UnifiedAuditLogIngestionEnabled"], "file": "audit-status.json", "role": "Audit Logs, or View-Only Audit Logs", "tasks": ["audit", "drift"], "doc": "https://learn.microsoft.com/purview/audit-log-enable-disable" },
    { "id": "transportRules", "shell": "exo", "cmdlet": "Get-TransportRule", "args": {}, "file": "transport-rules.json", "role": "Organization Management, or View-Only Configuration", "tasks": ["protection", "drift"], "doc": "https://learn.microsoft.com/exchange/security-and-compliance/mail-flow-rules/mail-flow-rules" },
    { "id": "omeConfiguration", "shell": "exo", "cmdlet": "Get-OMEConfiguration", "args": {}, "file": "ome-configuration.json", "role": "Organization Management, or View-Only Configuration", "tasks": ["protection"], "doc": "https://learn.microsoft.com/purview/manage-office-365-message-encryption" },
    { "id": "aipConfiguration", "shell": "aip", "cmdlet": "Get-AipServiceConfiguration", "args": {}, "optional": "rightsManagement", "file": "aipservice-configuration.json", "role": "Global Reader, or another role Connect-AipService accepts", "tasks": ["protection", "drift"], "doc": "https://learn.microsoft.com/powershell/module/aipservice/get-aipserviceconfiguration" }
  ]
}
