{
  "_comment": "Every Microsoft Graph call the pack makes, the task that makes it and the least privilege Microsoft Learn names for it (read November 27, 2026). Azure calls name the Azure role instead of a Graph permission. docs/reference/permissions-by-run.md is built from this file, and tests/HelpDeskAutomation.Tests.ps1 fails if the module calls an endpoint not declared here.",
  "tasks": {
    "typed-change-plan": {
      "mode": "read",
      "graphPermissions": [
        "User.Read.All"
      ],
      "azureRoles": [],
      "adRights": []
    },
    "typed-change-apply": {
      "mode": "write",
      "graphPermissions": [
        "User.Read.All",
        "User.ReadUpdate.All"
      ],
      "azureRoles": [],
      "adRights": [],
      "delegatedRole": "User Administrator, activated through PIM against the ticket, or the approved write pipeline (WD-182)"
    },
    "consent-requests": {
      "mode": "read",
      "graphPermissions": [
        "ConsentRequest.Read.All"
      ],
      "azureRoles": [],
      "adRights": []
    },
    "sync-check": {
      "mode": "read",
      "graphPermissions": [
        "Organization.Read.All",
        "User.Read.All",
        "ServiceHealth.Read.All"
      ],
      "azureRoles": [],
      "adRights": []
    },
    "role-review": {
      "mode": "read",
      "graphPermissions": [
        "RoleManagement.Read.Directory",
        "DeviceManagementRBAC.Read.All"
      ],
      "azureRoles": [],
      "adRights": []
    },
    "log-forwarding-check": {
      "mode": "read",
      "graphPermissions": [],
      "azureRoles": [
        "Reader",
        "Log Analytics Reader"
      ],
      "adRights": []
    },
    "log-forwarding-deploy": {
      "mode": "write",
      "graphPermissions": [],
      "azureRoles": [
        "A role that can create data collection rules and their associations on the Arc machines (confirm the built-in role in the test stage)"
      ],
      "adRights": [],
      "delegatedRole": "A person deploying the reviewed template, not the scheduled identity"
    }
  },
