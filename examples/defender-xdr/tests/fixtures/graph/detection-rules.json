{
  "@odata.context": "https://graph.microsoft.com/v1.0/$metadata#security/rules/detectionRules",
  "value": [
    {
      "@odata.type": "#microsoft.graph.security.detectionRule",
      "id": "contoso-office-encoded-powershell",
      "displayName": "Suspicious encoded PowerShell from Office",
      "description": "Encoded PowerShell launched by an Office application.",
      "status": "disabled",
      "queryCondition": {
        "queryText": "DeviceProcessEvents | where InitiatingProcessFileName in~ ('winword.exe','excel.exe','outlook.exe') | where FileName == 'powershell.exe' | where ProcessCommandLine has '-enc'"
      },
      "schedule": {
        "frequency": "PT1H"
      },
      "detectionAction": {
        "alertTemplate": {
          "title": "Suspicious encoded PowerShell from Office",
          "description": "An Office app launched an encoded PowerShell command.",
          "severity": "high",
          "recommendedActions": "Investigate the parent document and the user's recent email.",
          "entityMappings": {
            "hosts": [
              {
                "deviceIdColumn": "DeviceId",
                "nameColumn": "DeviceName"
              }
            ]
          },
          "tactics": [
            {
              "tactic": "Execution",
              "techniques": [
                {
                  "technique": "T1059.001"
                }
              ]
            }
          ]
        }
      }
    },
    {
      "@odata.type": "#microsoft.graph.security.detectionRule",
      "id": "contoso-legacy-rdp-rule",
      "displayName": "Legacy RDP rule made in the portal",
      "status": "enabled",
      "queryCondition": {
        "queryText": "DeviceLogonEvents | where LogonType == 'RemoteInteractive'"
      },
      "schedule": {
        "frequency": "PT24H"
      },
      "detectionAction": {
        "alertTemplate": {
          "title": "RDP logon",
          "severity": "low",
          "description": "",
          "recommendedActions": "",
          "entityMappings": {},
          "tactics": []
        }
      }
    }
  ]
}
